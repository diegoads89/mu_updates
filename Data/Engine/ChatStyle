;==================================================
; Estilo novo do chat (fonte propria, chips arredondados, selos
; SYSTEM / GM / POST).
;
; Lido direto pelo Main.exe ao abrir o cliente -- nao passa pelo Encoder.
; Editar aqui e reabrir o jogo ja basta. Sem este arquivo, o chat volta ao
; visual antigo.
;
;   NewFontStyle = 0/1   liga o visual novo
;   NewFontFile  = .ttf  fonte do chat (a normalfont.ttf e a Arial padrao)
;   NewFontSize  = N     tamanho em pixels; 0 = automatico
;   NewLinePitch = N     altura de cada linha; minimo 15, padrao 20
;==================================================
[ChatInfo]
NewFontStyle = 1
; 24/09/2026: Noto Sans Condensed, a mesma do cliente de referencia (o
; fonts_en.ttf dele). Era Data\Engine\Fonts\NotoSansSC.ttf, mais larga.
NewFontFile = Data\Fonts\NotoSansCondensed.ttf
NewFontSize = 0
NewLinePitch = 20
